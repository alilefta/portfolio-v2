# Public production URL used for canonical links, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Create a sending-only API key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional Resend Segment for newsletter subscribers.
RESEND_SUBSCRIBER_SEGMENT_ID=

# Reserved sender identity for future newsletter sends.
NEWSLETTER_FROM_EMAIL="Ali Lefta Notes <notes@your-verified-domain.com>"

# Replace this with an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Ali Lefta Portfolio <contact@your-verified-domain.com>"

# Destination for portfolio enquiries.
CONTACT_TO_EMAIL="alilefta95@gmail.com"
